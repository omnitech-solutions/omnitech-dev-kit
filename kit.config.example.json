  },
  "roles": {
    "reader":       { "tools": "read,grep,glob",                 "max_time": "3m",  "approval": "always-ask", "thinking": "low" },
    "orchestrator": { "tools": "read,grep,glob",                 "max_time": "4m",  "approval": "always-ask", "thinking": "low" },
    "implementer":  { "tools": "read,grep,glob,edit,write,bash", "max_time": "12m", "approval": "yolo",       "thinking": "medium" },
    "verifier":     { "tools": "read,grep,glob,bash",            "max_time": "9m",  "approval": "yolo",       "thinking": "low" }
  },
  "harness_env": {
    "codex":    { "KIT_CODEX_PROVIDER": "openrouter" },
